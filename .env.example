# 大语言模型支持智谱AI，兼容OpenAI SDK的api和Ollama封装的本地api
# 大语言模型的url地址
LLM_BASE_URL = https://open.bigmodel.cn/api/paas/v4
# LLM_BASE_URL = https://api.deepseek.com/v1
# LLM_BASE_URL = https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL = https://api.siliconflow.cn/v1
# LLM_BASE_URL = https://ark.cn-beijing.volces.com/api/v3
# LLM_BASE_URL = http://127.0.0.1:11434/v1

# MiniMax OpenAI-compatible endpoint. The key is read from the computer environment.
# LLM_PROVIDER = minimax
# MINIMAX_BASE_URL = https://api.minimaxi.com/v1
# MINIMAX_MODEL = MiniMax-M3.1-Flash
# api_key_minimax =
# MINIMAX_API_KEY =

# 大语言模型的api key
LLM_API_KEY = 
# 大语言模型的名称
MODEL_NAME = glm-4-flash
# 可选 glm-4-flash, glm-4-plus, 
# deepseek-chat, deepseek-reasoner, 
# qwen-max, qwen2.5-7b-instruct-1m
# doubao-1-5-pro-32k

# yaml配置文件的选择，web指config/config-web.yaml
PY_ENVIRONMENT = web

# 官方智谱图片生成 API Key（不是 URL；不使用第三方代理 Key）
IMAGE_GENERATE_API = 
# 图片生成模型的名称
IMAGE_GENERATE_MODEL = cogview-3-flash
# IMAGE_PROVIDER = minimax
# MINIMAX_IMAGE_MODEL = MiniMax-H3-Image

# MiniMax 图片理解复用电脑环境变量中的 MiniMax 密钥。
# IMAGE_DESCRIBE_PROVIDER = minimax
# MINIMAX_VISION_MODEL = MiniMax-M3.1-Flash
# 官方智谱图片理解 API Key
IMAGE_DESCRIBE_API = 
# 多模态（图片理解）大模型的名称
IMAGE_DESCRIBE_MODEL = glm-4v-flash

# 视频生成模型api地址，目前只支持ZhipuAI
VIDEO_GENERATE_API = 
# 视频生成模型的名称
VIDEO_GENERATE_MODEL = cogvideox-flash
# You.com 联网搜索与深度研究 API（申请地址: https://ydc-index.io/docs）
YOUCOM_API_KEY =
# 本地 Neo4j 登录密码；仅在 .env 填写实际值。
NEO4J_PASSWORD=
